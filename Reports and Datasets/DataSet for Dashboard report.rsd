<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet2">
    <Query>
      <DataSourceReference>DataSource1</DataSourceReference>
      <DataSetParameters>
        <DataSetParameter Name="DimDepartmentsDeptName">
          <DefaultValue>=new Object() {"[Dim Departments].[Dept Name].&amp;[Accounting #001010]", "[Dim Departments].[Dept Name].&amp;[Accounting #002919]", "[Dim Departments].[Dept Name].&amp;[Accounting #003910]", "[Dim Departments].[Dept Name].&amp;[Accounting #009832]"}</DefaultValue>
          <ReadOnly>false</ReadOnly>
          <Nullable>false</Nullable>
          <OmitFromQuery>false</OmitFromQuery>
          <rd:DbType>Object</rd:DbType>
          <rd:IsMultiValued>true</rd:IsMultiValued>
        </DataSetParameter>
      </DataSetParameters>
      <CommandText> SELECT NON EMPTY { [Measures].[Amount], [Measures].[Amount YTD], KPIValue("Accruals Performance"), KPIGoal("Accruals Performance"), KPIStatus("Accruals Performance"), KPITrend("Accruals Performance") } ON COLUMNS, NON EMPTY { ([Dim Date].[Year].[Year].ALLMEMBERS * [Dim Departments].[Dept Name].[Dept Name].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Dim Date].[Year].&amp;[2019] } ) ON COLUMNS FROM ( SELECT ( STRTOSET(@DimDepartmentsDeptName, CONSTRAINED) ) ON COLUMNS FROM [Payroll DW])) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</CommandText>
      <rd:DesignerState>
        <QueryDefinition xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/AnalysisServices/QueryDefinition">
          <CommandType>MDX</CommandType>
          <QuerySpecification xsi:type="MDXQuerySpecification">
            <Select>
              <Items>
                <Item>
                  <ID xsi:type="Level">
                    <DimensionName>Dim Date</DimensionName>
                    <HierarchyName>Year</HierarchyName>
                    <HierarchyUniqueName>[Dim Date].[Year]</HierarchyUniqueName>
                    <LevelName>Year</LevelName>
                    <UniqueName>[Dim Date].[Year].[Year]</UniqueName>
                  </ID>
                  <ItemCaption>Year</ItemCaption>
                  <UniqueName>true</UniqueName>
                </Item>
                <Item>
                  <ID xsi:type="Level">
                    <DimensionName>Dim Departments</DimensionName>
                    <HierarchyName>Dept Name</HierarchyName>
                    <HierarchyUniqueName>[Dim Departments].[Dept Name]</HierarchyUniqueName>
                    <LevelName>Dept Name</LevelName>
                    <UniqueName>[Dim Departments].[Dept Name].[Dept Name]</UniqueName>
                  </ID>
                  <ItemCaption>Dept Name</ItemCaption>
                  <UniqueName>true</UniqueName>
                </Item>
                <Item>
                  <ID xsi:type="Measure">
                    <MeasureName>Amount</MeasureName>
                    <UniqueName>[Measures].[Amount]</UniqueName>
                  </ID>
                  <ItemCaption>Amount</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                </Item>
                <Item>
                  <ID xsi:type="Measure">
                    <MeasureName>Amount YTD</MeasureName>
                    <UniqueName>[Measures].[Amount YTD]</UniqueName>
                  </ID>
                  <ItemCaption>Amount YTD</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                </Item>
                <Item>
                  <ID xsi:type="KPIMeasure">
                    <KPIName>Accruals Performance</KPIName>
                    <UniqueName>[Measures].[Amount]</UniqueName>
                  </ID>
                  <ItemCaption>Accruals Performance Value</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                  <KPIName>Accruals Performance</KPIName>
                  <KPICaption>Accruals Performance</KPICaption>
                </Item>
                <Item>
                  <ID xsi:type="KPIMeasure">
                    <KPIName>Accruals Performance</KPIName>
                    <KPIComponent>Goal</KPIComponent>
                    <UniqueName>[Measures].[Accruals Performance Goal]</UniqueName>
                  </ID>
                  <ItemCaption>Accruals Performance Goal</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                  <KPIName>Accruals Performance</KPIName>
                  <KPIComponent>Goal</KPIComponent>
                  <KPICaption>Accruals Performance</KPICaption>
                </Item>
                <Item>
                  <ID xsi:type="KPIMeasure">
                    <KPIName>Accruals Performance</KPIName>
                    <KPIComponent>Status</KPIComponent>
                    <UniqueName>[Measures].[Accruals Performance Status]</UniqueName>
                  </ID>
                  <ItemCaption>Accruals Performance Status </ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                  <KPIName>Accruals Performance</KPIName>
                  <KPIComponent>Status</KPIComponent>
                  <KPICaption>Accruals Performance</KPICaption>
                  <KPIGraphic>Shapes</KPIGraphic>
                </Item>
                <Item>
                  <ID xsi:type="KPIMeasure">
                    <KPIName>Accruals Performance</KPIName>
                    <KPIComponent>Trend</KPIComponent>
                    <UniqueName>[Measures].[Accruals Performance Trend]</UniqueName>
                  </ID>
                  <ItemCaption>Accruals Performance Trend</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                  <KPIName>Accruals Performance</KPIName>
                  <KPIComponent>Trend</KPIComponent>
                  <KPICaption>Accruals Performance</KPICaption>
                  <KPIGraphic>Standard Arrow</KPIGraphic>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <From>Payroll DW</From>
            <Filter>
              <FilterItems>
                <FilterItem>
                  <HierarchyUniqueName>[Dim Departments].[Dept Name]</HierarchyUniqueName>
                  <Condition xsi:type="EqualTo">
                    <Members>
                      <Member>
                        <MemberUniqueName>[Dim Departments].[Dept Name].&amp;[Accounting #001010]</MemberUniqueName>
                      </Member>
                      <Member>
                        <MemberUniqueName>[Dim Departments].[Dept Name].&amp;[Accounting #002919]</MemberUniqueName>
                      </Member>
                      <Member>
                        <MemberUniqueName>[Dim Departments].[Dept Name].&amp;[Accounting #003910]</MemberUniqueName>
                      </Member>
                      <Member>
                        <MemberUniqueName>[Dim Departments].[Dept Name].&amp;[Accounting #009832]</MemberUniqueName>
                      </Member>
                    </Members>
                    <Parametrized>true</Parametrized>
                  </Condition>
                </FilterItem>
                <FilterItem>
                  <HierarchyUniqueName>[Dim Date].[Year]</HierarchyUniqueName>
                  <Condition xsi:type="EqualTo">
                    <Members>
                      <Member>
                        <MemberUniqueName>[Dim Date].[Year].&amp;[2019]</MemberUniqueName>
                      </Member>
                    </Members>
                  </Condition>
                </FilterItem>
              </FilterItems>
            </Filter>
            <Calculations />
            <Aggregates />
            <QueryProperties>
              <IncludeMemberValue>true</IncludeMemberValue>
            </QueryProperties>
          </QuerySpecification>
          <Query>
            <Statement> SELECT NON EMPTY { [Measures].[Amount], [Measures].[Amount YTD], KPIValue("Accruals Performance"), KPIGoal("Accruals Performance"), KPIStatus("Accruals Performance"), KPITrend("Accruals Performance") } ON COLUMNS, NON EMPTY { ([Dim Date].[Year].[Year].ALLMEMBERS * [Dim Departments].[Dept Name].[Dept Name].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Dim Date].[Year].&amp;[2019] } ) ON COLUMNS FROM ( SELECT ( STRTOSET(@DimDepartmentsDeptName, CONSTRAINED) ) ON COLUMNS FROM [Payroll DW])) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</Statement>
            <ParameterDefinitions>
              <ParameterDefinition>
                <Name>DimDepartmentsDeptName</Name>
                <DefaultValues>
                  <DefaultValue>[Dim Departments].[Dept Name].&amp;[Accounting #001010]</DefaultValue>
                  <DefaultValue>[Dim Departments].[Dept Name].&amp;[Accounting #002919]</DefaultValue>
                  <DefaultValue>[Dim Departments].[Dept Name].&amp;[Accounting #003910]</DefaultValue>
                  <DefaultValue>[Dim Departments].[Dept Name].&amp;[Accounting #009832]</DefaultValue>
                </DefaultValues>
                <Caption>Dept Name</Caption>
                <HierarchyUniqueName>[Dim Departments].[Dept Name]</HierarchyUniqueName>
                <ParameterValuesQuery>
                  <Statement>WITH MEMBER [Measures].[ParameterCaption] AS [Dim Departments].[Dept Name].CURRENTMEMBER.MEMBER_CAPTION MEMBER [Measures].[ParameterValue] AS [Dim Departments].[Dept Name].CURRENTMEMBER.UNIQUENAME MEMBER [Measures].[ParameterLevel] AS [Dim Departments].[Dept Name].CURRENTMEMBER.LEVEL.ORDINAL SELECT {[Measures].[ParameterCaption], [Measures].[ParameterValue], [Measures].[ParameterLevel]} ON COLUMNS , [Dim Departments].[Dept Name].ALLMEMBERS ON ROWS FROM [Payroll DW]</Statement>
                  <ParameterizedStatement>
                    <ReferencedParameters />
                  </ParameterizedStatement>
                </ParameterValuesQuery>
                <MultipleValues>true</MultipleValues>
              </ParameterDefinition>
            </ParameterDefinitions>
          </Query>
        </QueryDefinition>
      </rd:DesignerState>
    </Query>
