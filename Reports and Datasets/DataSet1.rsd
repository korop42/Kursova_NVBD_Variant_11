                </Item>
                <Item>
                  <ID xsi:type="KPIMeasure">
                    <KPIName>Accruals Performance</KPIName>
                    <KPIComponent>Trend</KPIComponent>
                    <UniqueName>[Measures].[Accruals Performance Trend]</UniqueName>
                  </ID>
                  <ItemCaption>Accruals Performance Trend</ItemCaption>
                  <BackColor>true</BackColor>
                  <ForeColor>true</ForeColor>
                  <FontFamily>true</FontFamily>
                  <FontSize>true</FontSize>
                  <FontWeight>true</FontWeight>
                  <FontStyle>true</FontStyle>
                  <FontDecoration>true</FontDecoration>
                  <FormattedValue>true</FormattedValue>
                  <FormatString>true</FormatString>
                  <KPIName>Accruals Performance</KPIName>
                  <KPIComponent>Trend</KPIComponent>
                  <KPICaption>Accruals Performance</KPICaption>
                  <KPIGraphic>Standard Arrow</KPIGraphic>
                </Item>
              </Items>
            </Select>
            <AutoExecute>false</AutoExecute>
            <From>Payroll DW</From>
            <Filter>
              <FilterItems>
                <FilterItem>
                  <HierarchyUniqueName>[Dim Date].[Year]</HierarchyUniqueName>
                  <Condition xsi:type="EqualTo">
                    <Members>
                      <Member>
                        <MemberUniqueName>[Dim Date].[Year].&amp;[2024]</MemberUniqueName>
                      </Member>
                      <Member>
                        <MemberUniqueName>[Dim Date].[Year].&amp;[2025]</MemberUniqueName>
                      </Member>
                      <Member>
                        <MemberUniqueName>[Dim Date].[Year].&amp;[2023]</MemberUniqueName>
                      </Member>
                    </Members>
                  </Condition>
                </FilterItem>
              </FilterItems>
            </Filter>
            <Calculations />
            <Aggregates />
            <QueryProperties>
              <IncludeMemberValue>true</IncludeMemberValue>
            </QueryProperties>
          </QuerySpecification>
          <Query>
            <Statement> SELECT NON EMPTY { [Measures].[Amount YTD], [Measures].[Accruals YoY Growth %], KPIValue("Accruals Performance"), KPIGoal("Accruals Performance"), KPIStatus("Accruals Performance"), KPITrend("Accruals Performance") } ON COLUMNS, NON EMPTY { ([Dim Date].[Hierarchy].[Year].ALLMEMBERS ) } DIMENSION PROPERTIES MEMBER_CAPTION, MEMBER_VALUE, MEMBER_UNIQUE_NAME ON ROWS FROM ( SELECT ( { [Dim Date].[Year].&amp;[2024], [Dim Date].[Year].&amp;[2025], [Dim Date].[Year].&amp;[2023] } ) ON COLUMNS FROM [Payroll DW]) WHERE ( [Dim Date].[Year].CurrentMember ) CELL PROPERTIES VALUE, BACK_COLOR, FORE_COLOR, FORMATTED_VALUE, FORMAT_STRING, FONT_NAME, FONT_SIZE, FONT_FLAGS</Statement>
            <ParameterDefinitions />
          </Query>
        </QueryDefinition>
      </rd:DesignerState>
    </Query>
