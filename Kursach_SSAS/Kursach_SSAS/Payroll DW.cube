  <Source dwd:design-time-name="1c205cdb-8343-41b3-a323-505644ab2306">
    <DataSourceViewID>Payroll DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="dbbcc719-a7c3-4dc8-bdee-f70e7c1bfc8d">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Hourly Rate]
 AS [Measures].[Amount]/[Measures].[Hours Worked], 
FORMAT_STRING = "Currency", 
VISIBLE = 1; 
CREATE MEMBER CURRENTCUBE.[Measures].[Amount YTD]
 AS AGGREGATE( YTD([Dim Date].[Hierarchy].CurrentMember), [Measures].[Amount]), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Amount PY]
 AS (
  [Measures].[Amount], 
  PARALLELPERIOD([Dim Date].[Hierarchy].[Year], 1, [Dim Date].[Hierarchy].CurrentMember)
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Accruals YoY Growth %]
 AS IIF([Measures].[Amount PY] = 0, NULL,
  ([Measures].[Amount] - [Measures].[Amount PY]) / [Measures].[Amount PY]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Employee Rank]
 AS RANK(
  [Dim Employees].[FullName].CurrentMember,
  ORDER(
    [Dim Employees].[FullName].[FullName].Members,
    [Measures].[Amount],
    BDESC
  )
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Amount 3 Months]
 AS AVG(
  LASTPERIODS(3, [Dim Date].[Hierarchy].CurrentMember),
  [Measures].[Amount]
), 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[% of Total Accruals]
 AS [Measures].[Amount]/([Measures].[Amount],[Dim Departments].[Dept Name].[All]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Accruals YoY]
 AS ([Measures].[Amount] - ([Measures].[Amount], ParallelPeriod([Dim Date].[Hierarchy].[Year], 1, [Dim Date].[Hierarchy].CurrentMember))) 
/ ([Measures].[Amount], ParallelPeriod([Dim Date].[Hierarchy].[Year], 1, [Dim Date].[Hierarchy].CurrentMember)) * 100, 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="8e06a351-7f0a-4283-96c6-9485bd41c539">
      <ID>KPI</ID>
      <Name>Accruals Performance</Name>
      <Value>[Measures].[Amount]</Value>
      <Goal>([Measures].[Amount], ParallelPeriod([Dim Date].[Hierarchy].[Year], 1, [Dim Date].[Hierarchy].CurrentMember))</Goal>
      <Status>Case 
  When IsEmpty(KPIGoal("Accruals Performance")) Then 0
  When [Measures].[Amount] &gt;= KPIGoal("Accruals Performance") Then 1
  Else -1
End</Status>
      <Trend>Case  
  When [Measures].[Amount] &gt; ([Measures].[Amount], [Dim Date].[Hierarchy].PrevMember) Then 1
  When [Measures].[Amount] &lt; ([Measures].[Amount], [Dim Date].[Hierarchy].PrevMember) Then -1
  Else 0
End</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Shapes</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>